# ==============================================================================
# SpeakUp Stars — Environment Variables Specification (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed in Browser via Vite)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Your Supabase Anonymous Public Key (Safe for client browser)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Self-Hosted Aggregate Anonymous Metrics Endpoint
VITE_PRIVACY_METRICS_ENDPOINT=""

# Public Application Domain URL
VITE_PUBLIC_APP_URL="http://localhost:5173"


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (Supabase Edge Functions / Secret Manager)
# NEVER commit these keys or expose them to the browser client!
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Used for admin operations & scheduled retention jobs)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Anthropic Claude API Key (Processed with Zero Data Retention contract)
ANTHROPIC_API_KEY="sk-ant-api03-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Transactional Email Provider (Resend API Key for parent notifications)
RESEND_API_KEY="re_..."
TRANSACTIONAL_FROM_EMAIL="Sparky from SpeakUp Stars <support@speakupstars.com>"

# Secret token required to trigger the /run-retention-purge edge function from external cron
CRON_SECRET="your-high-entropy-random-cron-secret-token"

# Optional Stripe Keys (For Verified Parental Consent credit card authorization)
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
